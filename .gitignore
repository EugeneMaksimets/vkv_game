# Assets: ignore all asset files, but keep directories traversable
Assets/**
!Assets/**/

# Keep only C# source files and their .meta files
!Assets/**/*.cs
!Assets/**/*.cs.meta
!Assets/*.cs
!Assets/*.cs.meta

# Keep package manifest/lock so Unity knows which packages are used
!Packages/
!Packages/manifest.json
!Packages/packages-lock.json

# Ignore Unity project settings as requested
ProjectSettings/

# Ignore common OS files
.DS_Store
Thumbs.db



